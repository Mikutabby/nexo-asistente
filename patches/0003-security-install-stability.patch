+-        echo -n "[REDACTED]" | sha256sum | cut -d' ' -f1 > "$_hash_file"
++        echo -n "$_known_hash" > "$_hash_file"
+         chmod 600 "$_hash_file"
+     fi
+     local _stored_hash=$(cat "$_hash_file" 2>/dev/null)
+-    local _current_hash=$(echo -n "[REDACTED]" | sha256sum | cut -d' ' -f1)
+-    if [ "$_stored_hash" != "$_current_hash" ]; then
++    if [ "$_stored_hash" != "$_known_hash" ]; then
